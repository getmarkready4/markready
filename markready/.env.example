# Copy to .env.local and fill in your own values. Never commit .env.local.

# --- OpenRouter (LLM scoring) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Optional. Default: anthropic/claude-haiku-4.5 (Task 2 MVP).
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# --- Supabase (auth + submissions DB) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-anon-key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key

# --- Optional flags ---
# Set to 1 to lock the deployment: /api/* -> 503, UI routes -> /login.
# MAINTENANCE_MODE=1
# Set to 1 to allow the `model` override param outside of `next dev` (measurement only).
# ALLOW_MODEL_OVERRIDE=1
# Comma-separated list of allowed model IDs for override in production (empty = reject all overrides).
# OPENROUTER_ALLOWED_MODELS=anthropic/claude-opus-4-1,anthropic/claude-sonnet-4-20250514
